{
  "name": "rentlease-notchip-lab",
  "description": "Isolated Android panorama feasibility experiment",
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@notchip/expo-panoramic-stitcher": "0.7.0",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mts",
    "bundle:android": "expo export --platform android --output-dir dist",
    "postinstall": "node scripts/prepare-native.cjs"
  },
  "private": true
}
