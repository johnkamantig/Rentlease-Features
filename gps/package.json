{
  "name": "@rentlease/gps-local",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-independent GPS validation and local rental listing proximity utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js",
      "default": "./dist/rpc/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "default": "./dist/local.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "README.md"],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build",
    "test": "node --test tests/validation.test.ts tests/distance.test.ts tests/proximity.test.ts tests/rpc-contract.test.ts tests/package.test.ts",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
